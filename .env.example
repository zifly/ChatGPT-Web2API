# W2A_CDP_PORT   - Chrome remote debugging port (default: 9222)
# W2A_PORT       - API server port (default: 8080)
# W2A_HOST       - API server host (default: 127.0.0.1)
# W2A_HEADLESS   - Run Chrome headless: true/false (default: false)
# W2A_LOG_LEVEL  - Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# W2A_TAB_MODE   - Tab isolation: "owned" (default, dedicated tab per process)
#                  or "adopt" (reuse an existing chatgpt.com tab)
# W2A_PARALLEL_TABS - Parallel multi-tab mode: true/false (default: false).
#                  When true, requires tab_mode=owned; each bridge process
#                  drives its own tab with per-target locking. See
#                  docs/REST-CONCURRENCY.md for REST pool integration.
# W2A_REST_POOL_SIZE - REST workers (default: 1 = legacy singleton).
#                  Values >1 require W2A_PARALLEL_TABS=true and W2A_TAB_MODE=owned.
#                  NAS compose enables 2 workers. Distinct conversations overlap;
#                  the same conversation_id is serialized within this service.
# W2A_REST_POOL_MAX_QUEUE - Maximum waiting REST requests (default: 32).
#                  Queue wait counts toward request_timeout; excess gets 503.
#                  See docs/REST-CONCURRENCY.md for client migration and rollback.
#
# MCP tool access gates (see README "MCP Tool Access Control"):
# W2A_ENABLE_WRITE      - Expose mutating tools (create_project, update_project_instructions,
#                         create_memory, archive_conversation). Hidden by default.
# W2A_ENABLE_DESTRUCTIVE - Expose irreversible tools (delete_conversation, delete_memory).
#                         Hidden by default.

# Uncomment to override:
# W2A_CDP_PORT=9222
# W2A_PORT=8080
# W2A_HOST=127.0.0.1
# W2A_HEADLESS=false
# W2A_LOG_LEVEL=INFO
# W2A_ENABLE_WRITE=1
# W2A_ENABLE_DESTRUCTIVE=1
#
# E2E tests (opt-in; never run in CI — needs a logged-in browser + mutates account):
# W2A_E2E_RUN=1
#
# Reactive diagnostics: capture evidence when a driver function breaks (off by default).
# Artifacts go to ~/.chatgpt-web2api/diagnostics/. See README "Troubleshooting Drift".
# W2A_DIAGNOSE=1

# NAS Compose settings: copy to .env and customize locally.
# Published API/desktop ports default to loopback; set your own LAN IP if needed.
# An explicitly empty W2A_BIND_ADDRESS publishes on all host interfaces.
# W2A_BIND_ADDRESS=192.168.1.100
# W2A_REPLY_SOURCE=backend
# Runtime and build proxies are separate, and both default to disabled.
# W2A_PROXY_URL=http://host.docker.internal:3128
# W2A_BUILD_PROXY_URL=http://192.168.1.100:3128
# Optional Python package mirror; official PyPI is the default.
# W2A_PIP_INDEX_URL=https://pypi.org/simple
# Optional Debian mirrors; official repositories remain the defaults.
# W2A_DEBIAN_MIRROR=https://deb.debian.org/debian
# W2A_DEBIAN_SECURITY_MIRROR=https://security.debian.org/debian-security
# W2A_BUILD_NO_PROXY=localhost,127.0.0.1,::1
# Desktop login: 0 waits until login or shutdown; positive values are seconds.
# W2A_LOGIN_TIMEOUT_SECONDS=0
# W2A_REST_POOL_SIZE=2
# W2A_REST_POOL_MAX_QUEUE=32
# Optional standalone image deployment: supply an image built from this source.
# W2A_IMAGE=registry.example.com/your-project/chatgpt-web2api:your-version
# API keys belong in data/api.env; the VNC password belongs in data/vnc-password.txt.
