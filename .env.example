# W2A_CDP_PORT   - Chrome remote debugging port (default: 9222)
# W2A_PORT       - API server port (default: 8080)
# W2A_HOST       - API server host (default: 127.0.0.1)
# W2A_HEADLESS   - Run Chrome headless: true/false (default: false)
# W2A_LOG_LEVEL  - Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# W2A_TAB_MODE   - Tab isolation: "owned" (default, dedicated tab per process)
#                  or "adopt" (reuse an existing chatgpt.com tab)
# W2A_PARALLEL_TABS - Parallel multi-tab mode: true/false (default: false).
#                  When true, requires tab_mode=owned; each bridge process
#                  drives its own tab with per-target locking. See
#                  docs/deployment.md "Parallel mode (one Chrome, many tabs)".
#
# MCP tool access gates (see README "MCP Tool Access Control"):
# W2A_ENABLE_WRITE      - Expose mutating tools (create_project, update_project_instructions,
#                         create_memory, archive_conversation). Hidden by default.
# W2A_ENABLE_DESTRUCTIVE - Expose irreversible tools (delete_conversation, delete_memory).
#                         Hidden by default.

# Uncomment to override:
# W2A_CDP_PORT=9222
# W2A_PORT=8080
# W2A_HOST=127.0.0.1
# W2A_HEADLESS=false
# W2A_LOG_LEVEL=INFO
# W2A_ENABLE_WRITE=1
# W2A_ENABLE_DESTRUCTIVE=1
#
# E2E tests (opt-in; never run in CI — needs a logged-in browser + mutates account):
# W2A_E2E_RUN=1
#
# Reactive diagnostics: capture evidence when a driver function breaks (off by default).
# Artifacts go to ~/.chatgpt-web2api/diagnostics/. See README "Troubleshooting Drift".
# W2A_DIAGNOSE=1

# NAS Compose settings: copy to .env and set the NAS LAN IP explicitly.
# W2A_BIND_ADDRESS=192.168.1.100
# Optional HTTP proxy; use the actual HTTP port, not a SOCKS port.
# W2A_PROXY_URL=http://host.docker.internal:3128

# Defaults: official package sources; no build/runtime proxy.
# Optional mainland-China network settings (mirrors and proxies are independent):
# W2A_DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# W2A_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Security updates stay on the official source unless explicitly changed:
# W2A_DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# W2A_BUILD_PROXY_URL=http://host.docker.internal:3128
# W2A_BUILD_NO_PROXY=localhost,127.0.0.1,::1
# Desktop: 0 waits indefinitely for manual login; positive values are seconds.
# W2A_LOGIN_TIMEOUT_SECONDS=0

# Experimental: browser sends, backend protocol reads the completed reply.
# No DOM fallback; unresolved conversation IDs fail explicitly.
# W2A_REPLY_SOURCE=backend
