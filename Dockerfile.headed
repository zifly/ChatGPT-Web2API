FROM chatgpt-web2api-base:local

ARG PIP_INDEX_URL=https://pypi.org/simple

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11-utils x11vnc novnc websockify fluxbox fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
# Open the desktop client directly when visiting port 6080 without a path.
RUN ln -sfn vnc.html /usr/share/novnc/index.html

COPY docker-desktop.sh /docker-desktop.sh
RUN sed -i 's/\r$//' /docker-desktop.sh && chmod +x /docker-desktop.sh
ENV DISPLAY=:99
ENV W2A_HEADLESS=false
EXPOSE 6080
ENTRYPOINT ["/docker-desktop.sh"]

# Reinstall updated application code while retaining cached Chrome/desktop layers.
COPY src /app/src
COPY pyproject.toml /app/pyproject.toml
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" /app
